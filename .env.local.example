# ============================================
# GitHub
# ============================================
# Personal Access Token (classic) com escopo: read:user, repo, project (Project board da org)
# Gerar em: https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_USERNAME=

# Token opcional dedicado SÓ pra GitHub Project (se quiser separar do GITHUB_TOKEN)
GITHUB_PROJECT_TOKEN=

# ============================================
# App
# ============================================
# Token simples para proteger as rotas de sync (qualquer string aleatoria)
SYNC_SECRET=mude-isso-para-algo-aleatorio

# Intervalo do sync automatico em minutos (default 10)
SYNC_INTERVAL_MIN=10
