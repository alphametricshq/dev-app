# ============================================
# GitHub
# ============================================
# Personal Access Token (classic) com escopo: read:user, repo (privados se quiser)
# Gerar em: https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_USERNAME=

# ============================================
# Trello
# ============================================
# API Key: https://trello.com/app-key
# Token: clicar em "Token" na mesma pagina apos pegar a API Key
TRELLO_API_KEY=
TRELLO_TOKEN=

# IDs das listas que representam "Done" / "Concluido" (separadas por virgula)
# Para descobrir: rodar GET /1/boards/{boardId}/lists com sua key+token
# Deixe vazio para detectar automaticamente listas com nome "Done", "Concluido", "Feito"
TRELLO_DONE_LIST_IDS=

# ============================================
# App
# ============================================
# Token simples para proteger as rotas de sync (qualquer string aleatoria)
SYNC_SECRET=mude-isso-para-algo-aleatorio

# Intervalo do sync automatico em minutos (default 30)
SYNC_INTERVAL_MIN=30
